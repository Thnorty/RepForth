*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild
.cxx
*.apk
*.aab
*.keystore
*.jks
!debug.keystore

# The release signing key lives in ~/.repforth, not here. This is belt and
# braces for anyone who copies it in anyway: the repository is public, and a
# key committed once is a key that has to be replaced.
signing.properties

# Never commit provider credentials (§8, §18).
.env
*.env
!.env.example

# Scratch space used while scaffolding.
_staging/

# Kotlin compiler session files (Kotlin 2.x daemon scratch)
.kotlin/

# Downloaded upstream dataset. Never committed: the media carries a separate
# visual copyright exception (§6), and the metadata is regenerated by the importer.
.dataset-cache/

# Python bytecode from the tools scripts.
__pycache__/
*.pyc

# Local only: a device export contains the maintainer's own training data,
# and the probe case file is scratch regenerated per investigation.
/repforth-v1-backup.json
tools/probe-cases.generated.ps1
