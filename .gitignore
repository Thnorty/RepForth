!debug.keystore

# The release signing key. It lives in the working tree now, at the owner's
# request, so this is load-bearing rather than belt and braces: the repository
# is public, and a key committed once is a key that has to be replaced and every
# existing install orphaned.
#
# Three things keep it out, because one is not enough for a file this costly to
# leak. This entry; the `*.jks` and `signing.properties` rules above; and
# `.repforth/.gitignore`, which excludes everything in the folder from inside it
# and so survives an edit to this file. The build also refuses to sign with a
# key git is not ignoring -- see ReleaseSigning.kt.
/.repforth/
signing.properties

# Never commit provider credentials (§8, §18).
.env
*.env
!.env.example

# Scratch space used while scaffolding.
_staging/

# Kotlin compiler session files (Kotlin 2.x daemon scratch)
.kotlin/

# Downloaded upstream dataset. Never committed: the media carries a separate
# visual copyright exception (§6), and the metadata is regenerated by the importer.
.dataset-cache/

# Python bytecode from the tools scripts.
__pycache__/
*.pyc

# Local only: a device export contains the maintainer's own training data,
# and the probe case file is scratch regenerated per investigation.
/repforth-v1-backup.json
tools/probe-cases.generated.ps1
