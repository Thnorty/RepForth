        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outlined|elevated)$/]",
        "message": "<Card> variant must be one of 'filled' | 'outlined' | 'elevated'."
