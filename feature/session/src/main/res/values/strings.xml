<?xml version="1.0" encoding="utf-8"?>
<!-- The running workout. -->
<resources>
    <string name="session_title">Workout</string>
    <string name="session_exercise_of">Exercise %1$d of %2$d</string>
    <string name="session_set_of">Set %1$d of %2$d</string>
    <string name="session_target_weight">%1$s %2$s</string>
    <string name="session_target_bodyweight">Bodyweight</string>

    <string name="session_seconds">Seconds</string>
    <string name="session_reps">Reps</string>
    <string name="session_log_set">Log set</string>
    <string name="session_skip_set">Skip set</string>
<!--
        §3's perceived effort, asked once about the whole workout. Optional.

        Five sentences rather than a number out of ten: 6 and 7 differ by nothing
        anybody could describe, and the middle one here is what a well-judged
        session lands on, which is the answer worth having.
    -->
    <string name="session_effort">How hard was it? (optional)</string>
    <!-- §3's workout note, offered once the last set is done. -->
    <string name="session_note">Workout note (optional)</string>
    <string name="session_note_hint">How did it go?</string>

    <!--
        §3's answer, carried into the plan.

        The card is offered on the finish screen once an easy or a hard answer is
        chosen, and writes only if the user turns it on. "Just right" offers
        nothing, which is the point of a five-point scale: the middle is where a
        well-judged session lands and there is nothing to correct.
    -->
    <string name="session_adjust_harder">Make %1$s harder next time</string>
    <string name="session_adjust_easier">Make %1$s easier next time</string>
    <!-- Before and after, for one row of the card. -->
    <string name="session_adjust_weight">%1$s → %2$s %3$s</string>
    <string name="session_adjust_reps">%1$d → %2$d reps</string>
    <string name="session_adjust_seconds">%1$d → %2$d s</string>
    <!--
        A light load moves by less than the five kilograms a plan is written in,
        so the plan reads the same and the progress is real. Saying so beats a
        row that reads "10 kg → 10 kg", which looks broken rather than patient.
    -->
    <string name="session_adjust_creeping_one">%1$s stays at %2$s and moves closer to %3$s.</string>
    <string name="session_adjust_creeping_many">%1$d exercises keep their weight for now and move closer to the next one.</string>

    <string name="session_resting">Rest</string>
    <string name="session_skip_rest">Skip rest</string>
    <string name="session_rest_over">Rest is over</string>

    <string name="session_pause">Pause</string>
    <string name="session_resume">Resume</string>
    <string name="session_paused">Paused</string>
    <string name="session_finish">Finish workout</string>
    <string name="session_abandon">End without finishing</string>

    <string name="session_completing">Last set done. Finish when you are ready.</string>
    <string name="session_none">No workout is running.</string>

    <string name="session_confirm_abandon_title">End this workout?</string>
    <string name="session_confirm_abandon_body">Sets you already logged stay in your history. Only the rest of the workout is dropped.</string>
    <string name="session_confirm_abandon_yes">End it</string>
    <string name="session_confirm_abandon_no">Keep going</string>

    <string name="session_paused_rest">Paused · %1$s left</string>
    <string name="session_paused_set">Paused · %1$s left in the set</string>
    <string name="session_channel_name">Active workout</string>
    <string name="session_channel_description">Shows the current set and rest timer while a workout is running.</string>
    <string name="session_next_up">Next: %1$s</string>
    <!--
      What the next set asks for, under the preview on the rest screen. The
      second argument is a weight or the word for having none, so these read
      "12 reps · 62.5 kg" or "60 seconds · Bodyweight".
    -->
    <string name="session_next_target_reps">%1$d reps · %2$s</string>
    <string name="session_next_target_seconds">%1$d seconds · %2$s</string>
    <string name="session_conflict_title">A workout is already running</string>
    <string name="session_conflict_message">%1$s is still in progress. Anything already recorded is kept, whichever you choose.</string>
    <!-- Stands in for the plan name when a workout was started without one. -->
    <string name="session_conflict_unnamed">Your workout</string>
    <string name="session_conflict_keep">Go back to it</string>
    <string name="session_conflict_discard">Discard and start</string>
</resources>
