# Normalise line endings so the repo is identical on Windows, macOS, Linux and CI.
# Without this, `gradlew` gets CRLF on Windows checkouts and fails on Linux runners.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts and the Gradle wrapper must stay LF, always.
gradlew    text eol=lf
*.sh       text eol=lf

# Binaries git must not touch.
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.apk    binary
*.aab    binary
*.keystore binary

# PowerShell tooling is Windows-first, like the .bat wrapper above it.
*.ps1 text eol=crlf
