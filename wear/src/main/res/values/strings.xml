<?xml version="1.0" encoding="utf-8"?>
<!--
    The watch's own strings. Short on purpose: §11 asks for glanceability, and
    a wrist has room for about three words before it wraps.
-->
<resources>
    <string name="wear_app_name">RepForth</string>

    <string name="wear_disconnected_title">Phone not connected</string>
    <string name="wear_disconnected_detail">Controls are unavailable until it is back.</string>

    <string name="wear_no_workout_title">No workout</string>
    <string name="wear_no_workout_detail">Start one on your phone.</string>

    <!-- Which set of how many, under the rep target on the set page. -->
    <string name="wear_set_of">Set %1$d of %2$d</string>
    <!-- The unit under a rep target. The number is the hero; this only names it. -->
    <string name="wear_reps_label">Reps</string>
    <!-- Position in the workout, on the controls page where there is room to read it. -->
    <string name="wear_exercise_of">Exercise %1$d of %2$d</string>
    <!-- The unit under a timed set's countdown. Same word the phone uses. -->
    <string name="wear_seconds">Seconds</string>
    <!--
      The phone's words, not shorter ones. "Complete" and "Skip" dropped the
      noun, and without it "Complete" reads as finishing the exercise rather
      than recording a set - which is exactly how it was misread when it sat a
      swipe away from a control that did leave the exercise. Both fit.
    -->
    <string name="wear_complete_set">Log set</string>
    <string name="wear_skip_set">Skip set</string>
    <string name="wear_pause">Pause</string>
    <!--
        Leaves the exercise, abandoning the sets left on it. The phone calls it
        the same thing; two words for one command is how the protocol ended up
        with a duplicate action in the first place.
    -->
    <string name="wear_resume">Resume</string>

    <string name="wear_resting">Rest</string>
    <string name="wear_skip_rest">Skip rest</string>
    <string name="wear_next_up">Next: %1$s</string>

    <!--
        The notification channel behind the watch-face chip. User-visible in the
        system's own settings, so it is named for what it is rather than for the
        thing that posts it.
    -->
    <string name="wear_channel_workout">Active workout</string>

    <string name="wear_workout_finished">Workout finished</string>
    <string name="wear_workout_ended">Workout ended</string>
    <string name="wear_summary_on_phone">The summary is on your phone.</string>
</resources>
