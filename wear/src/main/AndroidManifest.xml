<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        §11: the watch is a remote for a workout the phone is running, so it is
        declared non-standalone. That is not a formality — it tells Play the app
        must not be offered to a watch whose phone does not have the companion,
        and it is the honest description of an app that has no workout engine,
        no catalog and no history of its own.
    -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        §3 asks for a haptic when a timed set or a rest reaches zero. A normal
        permission, granted at install, so there is nothing to prompt for — and
        whether it fires at all is the phone's decision: §11 gives the watch no
        settings, so "haptics off" is honoured by the phone not sending.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        §3's ongoing-activity entry is an ongoing notification underneath, so
        without this there is no way back from the watch face on Android 13 and
        above. `notify` does not fail there — it silently does nothing, which is
        why WearMainActivity asks and WearWorkoutNotification logs when it has
        been refused.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RepForthWearApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/wear_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receives the workout snapshot the phone publishes to
            /workout/active. Exported because the sender is Play Services
            delivering on the phone's behalf, not this app; the filter narrows
            it to Data Layer changes under that path.
        -->
        <service
            android:name=".WearStateListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/workout" />
            </intent-filter>
            <!--
                And a timer reaching zero, which travels as a message rather than
                as state: it is true at an instant, and the Data Layer's habit of
                keeping the last value would buzz a watch on reconnect for a rest
                that ended while it was in a drawer. A prefix filter like the
                phone's; the service checks the exact path itself.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/workout" />
            </intent-filter>
        </service>

    </application>

</manifest>
