<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The app's only network permission, and the only reason it has one.

        RepForth works entirely offline: the catalog is packaged, plans and
        history are local, and nothing is uploaded (§4). This exists solely so
        that a user who has configured their own AI provider can reach it (§8),
        which is a feature they switch on by pasting a key and which the app
        works completely without.

        Declared here rather than in core:ai so that "does this app talk to the
        internet, and why" is answerable from the one file an auditor opens.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Cloud backup is an explicit MVP non-goal (guideline §4), and §7 requires
        deciding whether history participates rather than letting the default
        decide. It is off.

        Not only policy: with it on, a reinstall restored the database from
        Google's servers, Room found the previous schema's identity hash in a
        file it had just been told to create from the packaged asset, and the
        app died at launch. Auto Backup restores across schema versions; Room
        refuses to open across them.

        Moving data between devices is the versioned JSON export in §7 — the
        user's copy, not Google's. BackupPolicyTest holds this to it.
    -->
    <application
        android:name=".RepForthApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepForth"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RepForth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
