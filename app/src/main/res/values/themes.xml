<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Launch theme only. All real theming lives in Compose (RepForthTheme);
        this exists so the window has a sane background before first composition.
        Dark-first, so the pre-composition background is charcoal, not white.
    -->
    <style name="Theme.RepForth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rf_launch_background</item>
        <item name="android:statusBarColor">@color/rf_launch_background</item>
        <item name="android:navigationBarColor">@color/rf_launch_background</item>
    </style>
</resources>
